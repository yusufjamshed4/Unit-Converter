        <div class="converter-body">
          <div class="unit-row">
            <div class="input-group">
              <label for="fromValue">From</label>
              <input type="number" id="fromValue" value="1" step="any" inputmode="decimal">
              <select id="fromUnit"></select>
            </div>

            <button class="swap-btn" id="swapBtn" title="Swap units">⇄</button>

            <div class="input-group">
              <label for="toValue">To</label>
              <input type="number" id="toValue" readonly>
              <select id="toUnit"></select>
            </div>
          </div>

          <div class="result-actions">
            <button class="action-btn" id="copyBtn">📋 Copy Result</button>
            <button class="action-btn" id="clearBtn">🗑️ Clear</button>
          </div>

          <div class="formula-box" id="formulaBox">
